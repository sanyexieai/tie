TIE_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
TIE_CORS_ORIGIN=http://tauri.localhost,https://tauri.localhost,tauri://localhost
# 默认主密钥保存在数据卷 /data/.private/vault.key，备份时需安全保留。
# TIE_VAULT_KEY_FILE=/run/secrets/tie-vault-key
# 内网固定操作目标须由管理员逐个允许，默认仅公共 HTTPS。
# TIE_VAULT_ALLOWED_ORIGINS=https://nas.internal:8443
