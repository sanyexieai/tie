{
  "name": "tie",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "vue-tsc -b",
    "test": "vitest run",
    "test:backend": "npm --prefix backend test",
    "test:e2e": "playwright test",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "node scripts/tauri-build.mjs",
    "tauri:build:linux": "tauri build --bundles deb,rpm",
    "tauri:build:windows": "tauri build --bundles msi,nsis",
    "tauri:android:dev": "node scripts/tauri-android-dev.mjs",
    "tauri:android:build": "tauri android build",
    "mcp": "node packages/tie-mcp/src/server.js",
    "mcp:setup": "node scripts/setup-codex-mcp.mjs",
    "test:mcp": "npm --prefix packages/tie-mcp test",
    "release": "node scripts/release-version.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.34.0",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-code-block-lowlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-table-cell": "^3.30.5",
    "@tiptap/extension-table-header": "^3.30.5",
    "@tiptap/extension-table-row": "^3.30.5",
    "@tiptap/extension-task-item": "^3.30.5",
    "@tiptap/extension-task-list": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/vue-3": "^3.30.5",
    "@vueuse/core": "^13.9.0",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.10.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.7"
  }
}
