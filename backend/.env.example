# Tie 后台可选配置
PORT=8787
TIE_BIND=127.0.0.1
TIE_JWT_SECRET=tie-dev-secret-change-me
# TIE_DATA_DIR=./data

# 生产环境（npm start 前设置）
# NODE_ENV=production
# TIE_JWT_SECRET=请替换为至少 32 字符的随机字符串
# TIE_BIND=127.0.0.1
# TIE_CORS_ORIGIN=https://your-tie-web-origin.example

# 配置后 /api/v1/ai/suggest-tags 将调用 OpenAI 兼容 API
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
