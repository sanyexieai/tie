# Tie 后台可选配置
PORT=8787
TIE_BIND=127.0.0.1
TIE_JWT_SECRET=tie-dev-secret-change-me
# TIE_DATA_DIR=./data

# 与后台一起启动 MCP HTTP。客户端连上后从 /health 读到地址，提示词会用这个地址。
# TIE_MCP_HTTP=1
# TIE_WORKSPACE=/绝对路径/含 pages 的工作区
# TIE_CLI=/绝对路径/tie.exe
# TIE_MCP_PORT=3927
# TIE_MCP_TOKEN=

# 生产环境（npm start 前设置）
# NODE_ENV=production
# TIE_JWT_SECRET=请替换为至少 32 字符的随机字符串
# TIE_BIND=127.0.0.1
# TIE_CORS_ORIGIN=https://your-tie-web-origin.example

# 配置后 /api/v1/ai/suggest-tags 将调用 OpenAI 兼容 API
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
